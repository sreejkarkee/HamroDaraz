@page
@model HamroDaraz.Pages.Products.DeleteModel

@{
    ViewData["Title"] = "Delete Product";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0">Delete Product</h4>
            </div>
            <div class="card-body">
                <p class="fs-5 text-danger fw-bold">Are you sure you want to delete this product?</p>
                <dl class="row">
                    <dt class="col-sm-4">Title</dt>
                    <dd class="col-sm-8">@Model.Product.Title</dd>

                    <dt class="col-sm-4">Price</dt>
                    <dd class="col-sm-8 text-success fw-bold">Rs. @Model.Product.Price.ToString("N2")</dd>

                    <dt class="col-sm-4">Category</dt>
                    <dd class="col-sm-8">@(Model.Product.Category?.Name ?? "N/A")</dd>

                    <dt class="col-sm-4">Production</dt>
                    <dd class="col-sm-8">@Model.Product.Production</dd>
                </dl>
                <form method="post">
                    <input type="hidden" asp-for="Product.Id" />
                    <div class="d-flex justify-content-between mt-4">
                        <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-danger">Confirm Delete</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
